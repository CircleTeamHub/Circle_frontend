# Copy to e2e/.env. This file is intentionally disabled and contains fake values only.
E2E_EXECUTE=false
E2E_ALLOW_MUTATION=false
E2E_API_URL=https://e2e-api.windnote.test
E2E_SOCKET_URL=wss://e2e-api.windnote.test
E2E_ALLOWED_ORIGINS=https://e2e-api.windnote.test,wss://e2e-api.windnote.test
E2E_AUTH_MODE=password
E2E_EMAIL=runner@example.test
E2E_PASSWORD=replace-with-a-dedicated-test-password
E2E_VERIFICATION_CODE=000000
E2E_RUN_ID=local-run-001
E2E_CONVERSATION_ID=11111111-1111-4111-8111-111111111111
E2E_CONVERSATION_NAME=WindNote-E2E-Conversation
E2E_ORIGINAL_NICKNAME=WindNote-E2E-Runner
E2E_DELETE_LABEL=Delete
E2E_FRIEND_ID=22222222-2222-4222-8222-222222222222
E2E_FRIEND_ACCOUNT=friend@example.test
E2E_CIRCLE_ID=33333333-3333-4333-8333-333333333333
E2E_CIRCLE_NAME=WindNote-E2E-Circle
E2E_PERF_CONVERSATION_ID=44444444-4444-4444-8444-444444444444
E2E_PERF_SECOND_CONVERSATION_ID=55555555-5555-4555-8555-555555555555

LOAD_EXECUTE=false
LOAD_ALLOW_MUTATION=false
LOAD_PERFORMANCE_FIXTURE=false
LOAD_API_URL=https://e2e-api.windnote.test
LOAD_SOCKET_URL=wss://e2e-api.windnote.test
LOAD_ALLOWED_ORIGINS=https://e2e-api.windnote.test,wss://e2e-api.windnote.test
# 生产主机判定的显式补充（逗号分隔，URL 或裸域名皆可）。CI 应从与构建同一个
# vars.EXPO_PUBLIC_API_URL 注入；环境里已有 EXPO_PUBLIC_API_URL 时会自动生效，
# 无需重复声明。留空则只用内置已知域名兜底。
LOAD_PRODUCTION_HOSTS=
E2E_PRODUCTION_HOSTS=
LOAD_ACCOUNTS_FILE=load-tests/data/accounts.local.json
LOAD_RUN_ID=local-load-001
LOAD_VUS=1
LOAD_DURATION_SECONDS=30
LOAD_CONVERSATIONS=100
LOAD_MESSAGES_PER_CONVERSATION=20
LOAD_TARGET_ALIAS=receiver

PERF_RESULTS_DIR=test-results/local-performance
PERF_DEVICE_ID=replace-with-an-adb-serial-or-ios-simulator-udid
PERF_SUITE=conversation-list-scroll
PERF_CAPTURE_PERFETTO=false
PERF_TRACE_DURATION_SECONDS=60
