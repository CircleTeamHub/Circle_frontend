# Normalize line endings: store everything as LF in the repo, regardless of
# the contributor's OS. Prevents whole-file CRLF/LF churn in diffs.
* text=auto eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.aac binary
*.zip binary
*.keystore binary
