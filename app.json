{
  "expo": {
    "name": "风信",
    "slug": "windnote-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "windnoteai",
      "circleim"
    ],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "com.yiboding.circleim",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "允许风信访问你的照片，用于选择并上传头像。",
        "NSLocationWhenInUseUsageDescription": "允许风信在使用期间获取位置，用于在聊天中分享当前位置。",
        "NSCameraUsageDescription": "允许风信使用相机拍照发送和扫描二维码。",
        "NSMicrophoneUsageDescription": "允许风信使用麦克风录制语音消息并进行语音通话。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.yiboding.circleim"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-web-browser",
      "expo-localization",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          },
          "ios": {
            "enableMultitaskingCameraAccess": false
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-camera",
        {
          "cameraPermission": "允许风信使用相机拍照发送和扫描二维码。",
          "microphonePermission": "允许风信使用麦克风录制语音消息并进行语音通话。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许风信使用麦克风录制语音消息并进行语音通话。",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "@sentry/react-native",
      "./plugins/with-local-sentry-auto-upload-disabled"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
