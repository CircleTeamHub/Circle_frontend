{
  "expo": {
    "name": "Circle IM",
    "slug": "circle-im",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "circleim",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1B23"
    },
    "ios": {
      "bundleIdentifier": "com.yiboding.circleim",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "允许 Circle IM 访问你的照片，用于选择并上传头像。",
        "NSLocationWhenInUseUsageDescription": "允许 Circle IM 在使用期间获取位置，用于在聊天中分享当前位置。",
        "NSCameraUsageDescription": "允许 Circle IM 使用相机扫描二维码。",
        "NSMicrophoneUsageDescription": "允许 Circle IM 使用麦克风录制语音消息并进行语音通话。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1B23",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yiboding.circleim"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-web-browser",
      "expo-localization",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          },
          "ios": {
            "enableMultitaskingCameraAccess": false
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-camera",
        {
          "cameraPermission": "允许 Circle IM 使用相机扫描二维码。",
          "microphonePermission": "允许 Circle IM 使用麦克风录制语音消息并进行语音通话。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许 Circle IM 使用麦克风录制语音消息并进行语音通话。",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
