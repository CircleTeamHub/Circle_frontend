# Required for every release build (native and web). Expo bakes this public
# HTTPS API origin into the artifact at build time.
EXPO_PUBLIC_API_URL=https://api.example.com

# Public EAS project identifier used to associate builds with an Expo project.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Extra object-storage / CDN origins that serve chat media, comma-separated.
# The upload contract returns an independent fileUrl, so whenever storage does
# not live on the API hostname its origin must be listed here — allowPeerMediaUrl
# renders media only from EXPO_PUBLIC_API_URL plus these origins, and everything
# else is dropped as a tracking beacon.
# This value is one half of a cross-repo contract: it must list whatever
# circle_be serves media from (OBJECT_STORAGE_DELIVERY_URL, else MINIO_PUBLIC_URL),
# and it has to ship in the SAME release as a backend cutover. Miss it and every
# image, voice note and cover goes blank while REST keeps working — in dev the
# console names the dropped origin once.
# EXPO_PUBLIC_MEDIA_ORIGINS=https://media.example.com

# Optional public invite origin for production, for example https://windnote.ai.
# Leave unset during local development: Expo Linking will generate an exp:// URL
# in Expo Go or a windnoteai:// URL in a development build.
# EXPO_PUBLIC_INVITE_BASE_URL=https://windnote.ai

# Optional Nominatim-compatible geocoder. Do not point production builds at the
# public OSMF instance; use a self-hosted or commercial endpoint with an SLA.
# On web, requests are issued by the parent app origin (not Origin: null), so
# the provider should allow the production user-Web origin in its CORS policy.
# EXPO_PUBLIC_GEOCODER_BASE_URL=https://geocoder.example.com

# Customer-service accounts are no longer build-time config. They live in the backend
# (SupportAgent), are maintained in the admin console, and the app fetches them at
# runtime via GET /support/config — so changing an agent no longer needs a new release.

# Test builds only (Maestro E2E targets): renders the hidden runtime API target
# marker that .maestro/subflows/launch.yaml asserts. Dev builds render it anyway.
# Never set this for store/production builds.
# EXPO_PUBLIC_E2E_BUILD=1

# Local path to the downloaded Android Firebase configuration file.
GOOGLE_SERVICES_FILE=./google-services.json
