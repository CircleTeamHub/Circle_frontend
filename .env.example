# Public EAS project identifier used to associate builds with an Expo project.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Optional in-app user id for the official membership support account.
EXPO_PUBLIC_MEMBERSHIP_SUPPORT_USER_ID=

# Dedicated customer-service IM account ids for the Customer Service center.
# Tapping a category opens the agent picker (one unified support avatar per agent);
# tapping an agent starts a 1:1 chat. Each category var accepts a COMMA-SEPARATED list
# to route to multiple agents, e.g. EXPO_PUBLIC_SUPPORT_RECHARGE_ID="agentA,agentB".
# Empty -> support-categories.ts falls back to imAdmin (the system admin), so recharge /
# dispute / account users would be routed to the admin instead of the intended agents.
# Generic support (fallback for entries without a dedicated account):
EXPO_PUBLIC_SUPPORT_ACCOUNT_ID=
# Category-specific agents (comma-separated for multiple per category):
EXPO_PUBLIC_SUPPORT_RECHARGE_ID=
EXPO_PUBLIC_SUPPORT_ISSUE_ID=
EXPO_PUBLIC_SUPPORT_DISPUTE_ID=
EXPO_PUBLIC_SUPPORT_ACCOUNT_AGENT_ID=

# Local path to the downloaded Android Firebase configuration file.
GOOGLE_SERVICES_FILE=./google-services.json
